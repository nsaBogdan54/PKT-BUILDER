# --- Packet Tracer files ---
# .pkt are binary, so only the files the tool actually needs are kept:
# the bundled donors inside the package and the 8lab reference.
*.pkt
*.pka
*.pkt.gz
!pkt_builder/data/*.pkt
!8lab.pkt

